PORT=3000
NODE_ENV=development

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sistem_stok_toko
DB_USER=postgres
DB_PASSWORD=GANTI_PASSWORD
DB_SSL=false
# Database untuk koneksi admin saat db:init (Aiven: defaultdb).
DB_ADMIN_DB=postgres
# Set true hanya jika ingin menghapus dan membuat ulang seluruh tabel.
DB_RESET=false

JWT_SECRET=ganti-dengan-string-acak-yang-panjang
JWT_EXPIRES_IN=1d

UPLOAD_DIR=uploads

# Cloudinary (opsional). Jika diisi, gambar produk disimpan ke Cloudinary.
# Jika dikosongkan, gambar disimpan lokal di folder UPLOAD_DIR.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
