NODE_ENV=production
PORT=3000

# Aiven for PostgreSQL
DB_HOST=pg-xxxxxxxx-inventra.a.aivencloud.com
DB_PORT=12345
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=GANTI_PASSWORD_AIVEN
DB_SSL=true
DB_ADMIN_DB=defaultdb
DB_RESET=false

JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_EXPIRES_IN=1d

UPLOAD_DIR=uploads

# Wajib untuk production agar gambar tidak hilang saat instance restart.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
